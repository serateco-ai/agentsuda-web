{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentsuda-web",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agentsuda.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
